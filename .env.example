# Copy this file to .env and enter SMTP details from your email provider.
# Never commit your real .env file or share SMTP credentials publicly.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
EMAIL_FROM=Reptasia Reptiles <tickets@your-verified-domain.example>
# Optional: an address where buyers can reply with questions.
REPLY_TO=tickets@your-verified-domain.example
BOOKINGS_FILE=./data/bookings.json
PORT=3000
